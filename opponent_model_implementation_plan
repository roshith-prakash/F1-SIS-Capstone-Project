```python
def build_target(df_race: pd.DataFrame) -> pd.Series:
    df = df_race.sort_values(['Driver', 'LapNumber'])
    df['pitted_next_lap'] = (
        df.groupby('Driver')['PitInTimeSeconds']
          .shift(-1)
          .notna()
          .astype(int)
    )
    return df['pitted_next_lap']
